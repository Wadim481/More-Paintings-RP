{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "hp4_paint:brush",
			"render_controllers": [
				{"controller.render.hp4_paint.chisel.fpp": "c.is_first_person"},
				{"controller.render.hp4_paint.chisel.tpp": "!c.is_first_person"}
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/hp/mp/attachables/brush",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"tpp": "geometry.hp4_paint.brush.attachable.tpp",
				"fpp": "geometry.hp4_paint.brush.attachable.fpp"
			},
			"animations": {
				"first_person_hold": "animation.hp4_paint.brush.first_person_hold",
				"third_person_hold": "animation.hp4_paint.brush.third_person_hold",
				"first_person_use": "animation.hp4_paint.brush.use_first_person",
				"third_person_use": "animation.hp4_paint.brush.use_third_person_hold2",
				"use_utils": "animation.hp4_paint.tools.use_utils",
				"use_controller": "controller.animation.hp4_paint.tools_utils"
			},
			"scripts": {
				"initialize": [
					"v.is_using = 0;",
					"v.is_use_fpp_playing = 0;"
				],
				"parent_setup": "t.is_using = (v.is_using ?? 0);",
				"pre_animation": [
					"v.is_using = t.is_using;"
				],
				"animate": [
					"use_controller",
					{
						"first_person_hold": "c.is_first_person && v.is_use_fpp_playing == 0"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}