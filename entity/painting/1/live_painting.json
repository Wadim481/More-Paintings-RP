                "pre_animation": [
                    "v.frame_size = q.property('hp4_paint:paint_models') == 0 ? 0:q.property('hp4_paint:paint_models') == 1 ? 1:q.property('hp4_paint:paint_models') == 2 ? 2:q.property('hp4_paint:paint_models') == 3 ? 3:q.property('hp4_paint:paint_models') == 4 ? 4:q.property('hp4_paint:paint_models') == 5 ? 6:q.property('hp4_paint:paint_models') == 6 ? 9: 0;",
                    "v.frame_type = q.property('hp4_paint:frame_type') == 'none' ? -1 : q.property('hp4_paint:frame_type') == 'black_modern' ? 0 : q.property('hp4_paint:frame_type') == 'burning' ? 1 : q.property('hp4_paint:frame_type') == 'decgold' ? 2 : q.property('hp4_paint:frame_type') == 'deciron' ? 3 : q.property('hp4_paint:frame_type') == 'diamond' ? 4 : q.property('hp4_paint:frame_type') == 'enchanted' ? 5 : q.property('hp4_paint:frame_type') == 'foliage' ? 6 : q.property('hp4_paint:frame_type') == 'glass' ? 7 : q.property('hp4_paint:frame_type') == 'glitter' ? 8 : q.property('hp4_paint:frame_type') == 'medieval' ? 9 : q.property('hp4_paint:frame_type') == 'pink' ? 10 : q.property('hp4_paint:frame_type') == 'white_modern' ? 11 : q.property('hp4_paint:frame_type') == 'wooden' ? 12 : -1;",
                    "v.frame_16x16 = v.frame_size == 0;",
                    "v.frame_16x32 = v.frame_size == 1;",
                    "v.frame_32x16 = v.frame_size == 2;",
                    "v.frame_32x32 = v.frame_size == 3;",
                    "v.frame_32x64 = false;",
                    "v.frame_48x48 = false;",
                    "v.frame_48x64 = false;",
                    "v.frame_64x32 = v.frame_size == 4;",
                    "v.frame_64x48 = v.frame_size == 6;",
                    "v.frame_64x64 = v.frame_size == 9;",
                    
                    "v.amount_16x16 = 2;",
                    "v.amount_16x32 = 2;",
                    "v.amount_32x16 = 2;",
                    "v.amount_32x32 = 2;",
                    "v.amount_32x64 = 2;",
                    "v.amount_48x48 = 0;",
                    "v.amount_48x64 = 2;",
                    "v.amount_64x32 = 0;",
                    "v.amount_64x48 = 0;",
                    "v.amount_64x64 = 2;",

                    "v.colors = q.property('hp4_paint:paint_colors') + 1;",

                    "v.end_16x16 = v.amount_16x16;",
                    "v.end_16x32 = v.end_16x16 + v.amount_16x32;",
                    "v.end_32x16 = v.end_16x32 + v.amount_32x16;",
                    "v.end_32x32 = v.end_32x16 + v.amount_32x32;",
                    "v.end_32x64 = v.end_32x32 + v.amount_32x64;",
                    "v.end_48x48 = v.end_32x64 + v.amount_48x48;",
                    "v.end_48x64 = v.end_48x48 + v.amount_48x64;",
                    "v.end_64x32 = v.end_48x64 + v.amount_64x32;",
                    "v.end_64x48 = v.end_64x32 + v.amount_64x48;",
                    "v.end_64x64 = v.end_64x48 + v.amount_64x64;",

                    "v.warna = q.property('hp4_paint:paint_colors') - math.floor(q.property('hp4_paint:paint_colors') / 2) * 2;",

                    "v.frame_amount = q.property('hp4_paint:paint_models') == 1 && v.warna == 0 ? 5 :q.property('hp4_paint:paint_models') == 3 && v.warna == 1 ? 3 :q.property('hp4_paint:paint_models') == 4 && v.warna == 0 ? 5 :q.property('hp4_paint:paint_models') == 5 && v.warna == 0 ? 3 :q.property('hp4_paint:paint_models') == 6 && v.warna == 0 ? 4 :q.property('hp4_paint:paint_models') == 6 && v.warna == 1 ? 3 :1;",
                    "v.fps = v.is_animating ? q.property('hp4_paint:paint_models') == 1 && v.warna == 0 ? 7 :q.property('hp4_paint:paint_models') == 3 && v.warna == 1 ? 7 :q.property('hp4_paint:paint_models') == 4 && v.warna == 0 ? 7 :q.property('hp4_paint:paint_models') == 5 && v.warna == 0 ? 7 :q.property('hp4_paint:paint_models') == 6 && v.warna == 0 ? 7 :q.property('hp4_paint:paint_models') == 6 && v.warna == 1 ? 7 :0 : 0;",

                    "v.frame_count = v.frame_16x16 ? v.amount_16x16 : v.frame_16x32 ? v.amount_16x32 : v.frame_32x16 ? v.amount_32x16 : v.frame_32x32 ? v.amount_32x32 : v.frame_32x64 ? v.amount_32x64 : v.frame_48x48 ? v.amount_48x48 : v.frame_48x64 ? v.amount_48x64 : v.frame_64x32 ? v.amount_64x32 : v.frame_64x48 ? v.amount_64x48 : v.frame_64x64 ? v.amount_64x64 : 0;"
                ],
                "animate": [
                    {
