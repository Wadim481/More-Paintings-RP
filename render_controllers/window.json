{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.hp4_paint.window": {
            "arrays": {
                "textures": {
                    "array.texture": [
                        "texture.default1",
                        "texture.default2",
                        "texture.default3",
                        "texture.default4"
                    ]
                }
            },
            "materials": [
                {
                    "*": "material.default",
                    "glass": "material.blend"
                }
            ],
            "geometry": "geometry.default",
            "textures": [
                "array.texture[q.property('hp4_paint:furniture_color')]"
            ],
            "is_hurt_color": {},
            "on_fire_color": {},
            "part_visibility": [
                {"up": "q.property('hp4_paint:upside')"},
                {"down": "q.property('hp4_paint:downside')"},
                {"right": "q.property('hp4_paint:rightside')"},
                {"left": "q.property('hp4_paint:leftside')"},
                {"upright": "q.property('hp4_paint:upright')"},
                {"upleft": "q.property('hp4_paint:upleft')"},
                {"downright": "q.property('hp4_paint:downright')"},
                {"downleft": "q.property('hp4_paint:downleft')"}
            ]
        },
        "controller.render.hp4_paint.window.outline": {
            "materials": [
                {
                    "*": "material.outline"
                }
            ],
            "geometry": "geometry.outline",
            "textures": [
                "texture.outline"
            ],
            "is_hurt_color": {},
            "on_fire_color": {},
			"overlay_color": {
				"a": 1,
				"r": 1,
				"g": 1,
				"b": 1
			},
			"ignore_lighting": true,
			"light_color_multiplier": 1,
            "part_visibility": [
                {"up": "q.property('hp4_paint:upside')"},
                {"down": "q.property('hp4_paint:downside')"},
                {"right": "q.property('hp4_paint:rightside')"},
                {"left": "q.property('hp4_paint:leftside')"},
                {"upright": "q.property('hp4_paint:upright')"},
                {"upleft": "q.property('hp4_paint:upleft')"},
                {"downright": "q.property('hp4_paint:downright')"},
                {"downleft": "q.property('hp4_paint:downleft')"}
            ]
        },
        "controller.render.hp4_paint.window_big": {
            "arrays": {
                "textures": {
                    "array.texture": [
                        "texture.default1",
                        "texture.default2",
                        "texture.default3",
                        "texture.default4"
                    ]
                }
            },
            "materials": [
                {
                    "*": "material.default"
                }
            ],
            "geometry": "geometry.default",
            "textures": [
                "array.texture[q.property('hp4_paint:furniture_color')]"
            ],
            "is_hurt_color": {},
            "on_fire_color": {}
        }
    }
}