{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.hp4_paint.tools_utils": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {"use": "v.is_using == 1"}
                    ]
                },
                "use": {
                    "on_entry": [
                        "v.is_use_fpp_playing = 1;"
                    ],
                    "on_exit": [
                        "v.is_use_fpp_playing = 0;"
                    ],
                    "animations": [
                        {"first_person_use": "c.is_first_person"},
                        {"third_person_use": "!c.is_first_person"}
                    ],
                    "transitions": [
                        {"default": "q.any_animation_finished"}
                    ]
                }
            }
        }
    }
}